{"ast":null,"code":"import api from '@/services/api';\nexport default {\n  data() {\n    return {\n      name: '',\n      email: '',\n      phoneNumber: '',\n      password: '',\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async register() {\n      this.loading = true;\n      this.error = '';\n      try {\n        await api.post('/clients', {\n          name: this.name,\n          email: this.email,\n          phoneNumber: this.phoneNumber,\n          password: this.password\n        });\n        this.$router.push('/login');\n      } catch (e) {\n        this.error = 'Nao foi possivel concluir o cadastro.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","name","email","phoneNumber","password","loading","error","methods","register","post","$router","push","e"],"sources":["C:\\MeusProjetos\\Front(MF)\\frontend\\src\\components\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"auth\">\n    <div class=\"panel\">\n      <p class=\"eyebrow\">Cadastro</p>\n      <h2>Crie sua conta</h2>\n      <p class=\"subtitle\">Atendimento rapido para seus pedidos favoritos.</p>\n\n      <form @submit.prevent=\"register\" class=\"form\">\n        <label>\n          Nome completo\n          <input v-model=\"name\" placeholder=\"Seu nome\" required />\n        </label>\n        <label>\n          Email\n          <input v-model=\"email\" type=\"email\" placeholder=\"seu@email.com\" required />\n        </label>\n        <label>\n          Telefone\n          <input v-model=\"phoneNumber\" placeholder=\"(DDD) 99999-9999\" required />\n        </label>\n        <label>\n          Senha\n          <input v-model=\"password\" type=\"password\" placeholder=\"Minimo 6 caracteres\" required />\n        </label>\n        <button class=\"btn primary\" type=\"submit\" :disabled=\"loading\">\n          {{ loading ? 'Enviando...' : 'Criar conta' }}\n        </button>\n      </form>\n      <p v-if=\"error\" class=\"error\">{{ error }}</p>\n      <p class=\"helper\">Ja tem conta? <router-link to=\"/login\">Entrar</router-link></p>\n    </div>\n\n    <div class=\"side\">\n      <h3>Vantagens de se cadastrar</h3>\n      <ul>\n        <li>Salve seus pedidos favoritos</li>\n        <li>Finalizacao rapida no Pix</li>\n        <li>Receba novidades e combos</li>\n      </ul>\n    </div>\n  </div>\n</template>\n\n<script>\nimport api from '@/services/api';\n\nexport default {\n  data() {\n    return {\n      name: '',\n      email: '',\n      phoneNumber: '',\n      password: '',\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async register() {\n      this.loading = true;\n      this.error = '';\n      try {\n        await api.post('/clients', {\n          name: this.name,\n          email: this.email,\n          phoneNumber: this.phoneNumber,\n          password: this.password\n        });\n        this.$router.push('/login');\n      } catch (e) {\n        this.error = 'Nao foi possivel concluir o cadastro.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.auth {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 24px;\n  align-items: stretch;\n}\n\n.panel {\n  background: #fff;\n  border-radius: 18px;\n  padding: 24px;\n  box-shadow: 0 12px 26px rgba(28, 19, 11, 0.08);\n}\n\n.side {\n  background: #fff3e2;\n  border-radius: 18px;\n  padding: 24px;\n  display: grid;\n  gap: 12px;\n}\n\n.side ul {\n  padding-left: 18px;\n  margin: 0;\n  display: grid;\n  gap: 8px;\n}\n\n.eyebrow {\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  font-size: 0.7rem;\n}\n\n.subtitle {\n  color: rgba(28, 19, 11, 0.7);\n}\n\n.form {\n  margin-top: 18px;\n  display: grid;\n  gap: 14px;\n}\n\nlabel {\n  display: grid;\n  gap: 6px;\n  font-size: 0.9rem;\n}\n\ninput {\n  padding: 12px 14px;\n  border-radius: 12px;\n  border: 1px solid rgba(28, 19, 11, 0.15);\n}\n\n.helper {\n  margin-top: 12px;\n}\n\n.error {\n  color: #c0392b;\n  margin-top: 8px;\n}\n\n.btn {\n  border: none;\n  background: #ffb347;\n  color: #1c130b;\n  padding: 12px 16px;\n  border-radius: 999px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.btn.primary {\n  background: #1c130b;\n  color: #fff7ea;\n}\n\n.btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n</style>\r\n"],"mappings":"AA4CA,OAAOA,GAAE,MAAO,gBAAgB;AAEhC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,EAAE;MACfC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,QAAQA,CAAA,EAAG;MACf,IAAI,CAACH,OAAM,GAAI,IAAI;MACnB,IAAI,CAACC,KAAI,GAAI,EAAE;MACf,IAAI;QACF,MAAMP,GAAG,CAACU,IAAI,CAAC,UAAU,EAAE;UACzBR,IAAI,EAAE,IAAI,CAACA,IAAI;UACfC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,WAAW,EAAE,IAAI,CAACA,WAAW;UAC7BC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QACF,IAAI,CAACM,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;MAC7B,EAAE,OAAOC,CAAC,EAAE;QACV,IAAI,CAACN,KAAI,GAAI,uCAAuC;MACtD,UAAU;QACR,IAAI,CAACD,OAAM,GAAI,KAAK;MACtB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}