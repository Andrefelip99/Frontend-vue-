{"ast":null,"code":"import api from '@/services/api';\nimport { setUser, setAuthBasic } from '@/services/user';\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async login() {\n      this.loading = true;\n      this.error = '';\n      try {\n        const response = await api.post('/clients/login', {\n          email: this.email,\n          password: this.password\n        });\n        const authBasic = btoa(`${this.email}:${this.password}`);\n        setAuthBasic(authBasic);\n        setUser(response.data);\n        this.$router.push('/products');\n      } catch (e) {\n        this.error = 'Email ou senha invalidos.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","setUser","setAuthBasic","data","email","password","loading","error","methods","login","response","post","authBasic","btoa","$router","push","e"],"sources":["C:\\MeusProjetos\\confeitariaMacedoFarias(Backend)\\frontend\\src\\components\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"auth\">\n    <div class=\"panel\">\n      <p class=\"eyebrow\">Macedo Farias</p>\n      <h2>Bem-vindo de volta</h2>\n      <p class=\"subtitle\">Entre para acompanhar seus pedidos e finalizar compras.</p>\n\n      <form @submit.prevent=\"login\" class=\"form\">\n        <label>\n          Email\n          <input v-model=\"email\" type=\"email\" placeholder=\"seu@email.com\" required />\n        </label>\n        <label>\n          Senha\n          <input v-model=\"password\" type=\"password\" placeholder=\"Digite sua senha\" required />\n        </label>\n        <button class=\"btn primary\" type=\"submit\" :disabled=\"loading\">\n          {{ loading ? 'Entrando...' : 'Entrar' }}\n        </button>\n      </form>\n      <p v-if=\"error\" class=\"error\">{{ error }}</p>\n      <p class=\"helper\">Ainda nao tem conta? <router-link to=\"/register\">Criar cadastro</router-link></p>\n    </div>\n\n    <div class=\"side\">\n      <h3>Doces feitos sob medida</h3>\n      <p>\n        Cadastre-se para receber novidades e garantir sua encomenda com rapidez.\n      </p>\n      <div class=\"highlight\">\n        <strong>Pix liberado</strong>\n        <span>Finalize o pedido e receba o QR Code na hora.</span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport api from '@/services/api';\nimport { setUser, setAuthBasic } from '@/services/user';\n\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async login() {\n      this.loading = true;\n      this.error = '';\n      try {\n        const response = await api.post('/clients/login', {\n          email: this.email,\n          password: this.password\n        });\n        const authBasic = btoa(`${this.email}:${this.password}`);\n        setAuthBasic(authBasic);\n        setUser(response.data);\n        this.$router.push('/products');\n      } catch (e) {\n        this.error = 'Email ou senha invalidos.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.auth {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 24px;\n  align-items: stretch;\n}\n\n.panel {\n  background: #fff;\n  border-radius: 18px;\n  padding: 24px;\n  box-shadow: 0 12px 26px rgba(28, 19, 11, 0.08);\n}\n\n.side {\n  background: linear-gradient(135deg, #1c130b, #4b2f14);\n  color: #fff7ea;\n  border-radius: 18px;\n  padding: 24px;\n  display: grid;\n  gap: 12px;\n  align-content: start;\n}\n\n.eyebrow {\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  font-size: 0.7rem;\n}\n\n.subtitle {\n  color: rgba(28, 19, 11, 0.7);\n}\n\n.form {\n  margin-top: 18px;\n  display: grid;\n  gap: 14px;\n}\n\nlabel {\n  display: grid;\n  gap: 6px;\n  font-size: 0.9rem;\n}\n\ninput {\n  padding: 12px 14px;\n  border-radius: 12px;\n  border: 1px solid rgba(28, 19, 11, 0.15);\n}\n\n.highlight {\n  background: rgba(255, 255, 255, 0.12);\n  padding: 12px;\n  border-radius: 12px;\n  display: grid;\n  gap: 6px;\n}\n\n.helper {\n  margin-top: 12px;\n}\n\n.error {\n  color: #c0392b;\n  margin-top: 8px;\n}\n\n.btn {\n  border: none;\n  background: #ffb347;\n  color: #1c130b;\n  padding: 12px 16px;\n  border-radius: 999px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.btn.primary {\n  background: #1c130b;\n  color: #fff7ea;\n}\n\n.btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n</style>\r\n"],"mappings":"AAsCA,OAAOA,GAAE,MAAO,gBAAgB;AAChC,SAASC,OAAO,EAAEC,YAAW,QAAS,iBAAiB;AAEvD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI,CAACH,OAAM,GAAI,IAAI;MACnB,IAAI,CAACC,KAAI,GAAI,EAAE;MACf,IAAI;QACF,MAAMG,QAAO,GAAI,MAAMV,GAAG,CAACW,IAAI,CAAC,gBAAgB,EAAE;UAChDP,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QACF,MAAMO,SAAQ,GAAIC,IAAI,CAAC,GAAG,IAAI,CAACT,KAAK,IAAI,IAAI,CAACC,QAAQ,EAAE,CAAC;QACxDH,YAAY,CAACU,SAAS,CAAC;QACvBX,OAAO,CAACS,QAAQ,CAACP,IAAI,CAAC;QACtB,IAAI,CAACW,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC;MAChC,EAAE,OAAOC,CAAC,EAAE;QACV,IAAI,CAACT,KAAI,GAAI,2BAA2B;MAC1C,UAAU;QACR,IAAI,CAACD,OAAM,GAAI,KAAK;MACtB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}