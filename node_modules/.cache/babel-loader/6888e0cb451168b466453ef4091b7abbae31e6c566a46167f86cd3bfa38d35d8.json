{"ast":null,"code":"import { getCartCount } from '@/services/cart';\nimport { getUser, clearUser } from '@/services/user';\nexport default {\n  name: 'App',\n  data() {\n    return {\n      cartCount: 0,\n      user: null\n    };\n  },\n  created() {\n    this.refreshState();\n  },\n  mounted() {\n    window.addEventListener('cart-updated', this.refreshState);\n    window.addEventListener('user-updated', this.refreshState);\n  },\n  beforeUnmount() {\n    window.removeEventListener('cart-updated', this.refreshState);\n    window.removeEventListener('user-updated', this.refreshState);\n  },\n  watch: {\n    $route() {\n      this.refreshState();\n    }\n  },\n  methods: {\n    refreshState() {\n      this.cartCount = getCartCount();\n      this.user = getUser();\n    },\n    logout() {\n      clearUser();\n      this.refreshState();\n      this.$router.push('/products');\n    }\n  }\n};","map":{"version":3,"names":["getCartCount","getUser","clearUser","name","data","cartCount","user","created","refreshState","mounted","window","addEventListener","beforeUnmount","removeEventListener","watch","$route","methods","logout","$router","push"],"sources":["C:\\MeusProjetos\\confeitariaMacedoFarias(Backend)\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\" class=\"app\">\n    <header class=\"site-header\">\n      <div class=\"brand\" @click=\"$router.push('/products')\">\n        <img class=\"brand-logo\" src=\"/logo-macedo-farias.png\" alt=\"Logo Macedo Farias\" />\n        <span class=\"brand-mark\">MF</span>\n        <div>\n          <strong>Macedo Farias</strong>\n          <small>Confeitaria</small>\n        </div>\n      </div>\n      <nav class=\"nav\">\n        <router-link to=\"/products\">Produtos</router-link>\n        <router-link to=\"/cart\">Carrinho ({{ cartCount }})</router-link>\n        <router-link to=\"/login\" v-if=\"!user\">Login</router-link>\n        <router-link to=\"/register\" v-if=\"!user\">Registrar</router-link>\n        <button v-if=\"user\" class=\"btn ghost\" @click=\"logout\">Sair</button>\n      </nav>\n    </header>\n\n    <main class=\"main\">\n      <router-view />\n    </main>\n\n    <footer class=\"footer\">\n      <div>\n        <strong>Macedo Farias</strong>\n        <p>Confeitaria com carinho, do nosso forno para sua mesa.</p>\n      </div>\n      <div>\n        <p>Atendimento: Seg a Sab</p>\n        <p>Pedidos e encomendas via Pix</p>\n      </div>\n    </footer>\n  </div>\n</template>\n\n<script>\nimport { getCartCount } from '@/services/cart';\nimport { getUser, clearUser } from '@/services/user';\n\nexport default {\n  name: 'App',\n  data() {\n    return {\n      cartCount: 0,\n      user: null\n    };\n  },\n  created() {\n    this.refreshState();\n  },\n  mounted() {\n    window.addEventListener('cart-updated', this.refreshState);\n    window.addEventListener('user-updated', this.refreshState);\n  },\n  beforeUnmount() {\n    window.removeEventListener('cart-updated', this.refreshState);\n    window.removeEventListener('user-updated', this.refreshState);\n  },\n  watch: {\n    $route() {\n      this.refreshState();\n    }\n  },\n  methods: {\n    refreshState() {\n      this.cartCount = getCartCount();\n      this.user = getUser();\n    },\n    logout() {\n      clearUser();\n      this.refreshState();\n      this.$router.push('/products');\n    }\n  }\n};\n</script>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@300;400;500;600&display=swap');\n\n:root {\n  color-scheme: light;\n  --bg: #f7f1e7;\n  --text: #1c130b;\n  --muted: rgba(28, 19, 11, 0.65);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background: radial-gradient(circle at top left, #fff1d6, #f7f1e7 40%, #efe8dd 100%);\n  color: var(--text);\n  font-family: 'Manrope', sans-serif;\n}\n\nh1, h2, h3, h4 {\n  font-family: 'Fraunces', serif;\n  margin: 0;\n}\n\np {\n  margin: 0;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\n.app {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n\n.site-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px 8vw;\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  backdrop-filter: blur(12px);\n  background: rgba(247, 241, 231, 0.8);\n  border-bottom: 1px solid rgba(28, 19, 11, 0.08);\n}\n\n.brand {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  cursor: pointer;\n}\n\n.brand-logo {\n  width: 48px;\n  height: 48px;\n  object-fit: contain;\n}\n\n.brand-mark {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  background: #1c130b;\n  color: #fff7ea;\n  border-radius: 14px;\n  font-weight: 700;\n}\n\n.brand small {\n  color: var(--muted);\n}\n\n.nav {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.nav a.router-link-active {\n  font-weight: 700;\n}\n\n.main {\n  flex: 1;\n  padding: 32px 8vw 48px;\n}\n\n.footer {\n  padding: 28px 8vw 36px;\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 20px;\n  border-top: 1px solid rgba(28, 19, 11, 0.08);\n}\n\n.btn {\n  border: none;\n  background: #ffb347;\n  color: #1c130b;\n  padding: 8px 14px;\n  border-radius: 999px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.btn.ghost {\n  background: transparent;\n  border: 1px solid rgba(28, 19, 11, 0.2);\n}\n\n@media (max-width: 720px) {\n  .site-header {\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .main {\n    padding: 24px 6vw 40px;\n  }\n}\n</style>\r\n"],"mappings":"AAsCA,SAASA,YAAW,QAAS,iBAAiB;AAC9C,SAASC,OAAO,EAAEC,SAAQ,QAAS,iBAAiB;AAEpD,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,CAAC;MACZC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC,CAAC;EACrB,CAAC;EACDC,OAAOA,CAAA,EAAG;IACRC,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACH,YAAY,CAAC;IAC1DE,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACH,YAAY,CAAC;EAC5D,CAAC;EACDI,aAAaA,CAAA,EAAG;IACdF,MAAM,CAACG,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACL,YAAY,CAAC;IAC7DE,MAAM,CAACG,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACL,YAAY,CAAC;EAC/D,CAAC;EACDM,KAAK,EAAE;IACLC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACP,YAAY,CAAC,CAAC;IACrB;EACF,CAAC;EACDQ,OAAO,EAAE;IACPR,YAAYA,CAAA,EAAG;MACb,IAAI,CAACH,SAAQ,GAAIL,YAAY,CAAC,CAAC;MAC/B,IAAI,CAACM,IAAG,GAAIL,OAAO,CAAC,CAAC;IACvB,CAAC;IACDgB,MAAMA,CAAA,EAAG;MACPf,SAAS,CAAC,CAAC;MACX,IAAI,CAACM,YAAY,CAAC,CAAC;MACnB,IAAI,CAACU,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC;IAChC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}